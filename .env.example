TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# Канал бот ↔ раннер (WebSocket). Секрет не коммитить.
SHERPA_CHANNEL_SECRET=
# Раннер: полный URL канала (бот слушает host/port/path ниже).
SHERPA_CHANNEL_URL=ws://127.0.0.1:8787/v1/channel
# Бот: bind. Локально 127.0.0.1; на VPS в compose — 0.0.0.0, publish только на WG.
# SHERPA_CHANNEL_HOST=127.0.0.1
# SHERPA_CHANNEL_PORT=8787
# SHERPA_CHANNEL_PATH=/v1/channel
# Prod (WG): ws://10.243.63.1:8787/v1/channel — см. deploy/README.md

# Реестр раннера (SQLite-файл). Данные не коммитить.
SHERPA_REGISTRY_PATH=data/registry.sqlite

# Дефолт mid-run доставки текста (раннер): interject | after. Нет ключа — interject.
# SHERPA_MID_RUN_DELIVERY=interject

